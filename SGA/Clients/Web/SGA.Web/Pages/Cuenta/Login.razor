@page "/login"
@layout LoginLayout
@using SGA.Web.Models.Auth
@using SGA.Web.Models.Common
@inject SgaApiService Api
@inject SesionState Sesion
@inject NavigationManager Nav

<div class="sga-login-fondo">
    <div class="sga-login-card">
        <div class="sga-login-badge">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8">
                <rect x="3" y="5" width="18" height="12" rx="2" />
                <path d="M3 12h18" />
                <circle cx="7.5" cy="19" r="1.5" fill="white" stroke="none" />
                <circle cx="16.5" cy="19" r="1.5" fill="white" stroke="none" />
            </svg>
        </div>

        <h1>SGA-ITLA</h1>
        <div class="subtitulo">Sistema de Gestión de Autobuses &mdash; Portal de Estudiantes y Conductores</div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="sga-mensaje-error">@_error</div>
        }

        <EditForm Model="_modelo" OnValidSubmit="IniciarSesionAsync">
            <div class="mb-3">
                <label class="form-label">Correo institucional</label>
                <InputText class="form-control" @bind-Value="_modelo.Correo" placeholder="nombre.apellido@itla.edu.do" />
            </div>
            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <InputText class="form-control" type="password" @bind-Value="_modelo.Password" />
            </div>
            <button type="submit" class="btn btn-sga-primario w-100" disabled="@_cargando">
                @(_cargando ? "Ingresando..." : "Iniciar sesión")
            </button>
        </EditForm>

        
    </div>
</div>

@code {
    private readonly LoginModel _modelo = new();
    private string? _error;
    private bool _cargando;

    protected override async Task OnInitializedAsync()
    {
        await Sesion.RestaurarAsync();
        if (Sesion.EstaAutenticado)
            Nav.NavigateTo("/", replace: true);
    }

    private async Task IniciarSesionAsync()
    {
        _error = null;
        _cargando = true;
        try
        {
            var resultado = await Api.PostAsync<LoginResponseModel>("api/auth/login", new { _modelo.Correo, _modelo.Password });

            if (!resultado.EsExitoso || resultado.Valor?.Usuario is null)
            {
                _error = resultado.Error ?? "Credenciales incorrectas.";
                return;
            }

            await Sesion.IniciarSesionAsync(resultado.Valor.Usuario, resultado.Valor.Token);
            Nav.NavigateTo("/", replace: true);
        }
        finally
        {
            _cargando = false;
        }
    }
}
