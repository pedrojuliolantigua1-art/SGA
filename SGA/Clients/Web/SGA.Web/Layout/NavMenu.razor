@inject SesionState Sesion

<nav class="sga-nav nav flex-column">
    @if (Sesion.Usuario?.EsEstudiante == true || Sesion.Usuario?.EsEmpleado == true)
    {
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        <NavLink class="nav-link" href="estudiante/rutas">Rutas y Horarios</NavLink>
        <NavLink class="nav-link" href="estudiante/viajes-del-dia">Viajes del Día</NavLink>
        <NavLink class="nav-link" href="estudiante/billetera">Billetera</NavLink>
        <NavLink class="nav-link" href="estudiante/comprar-ticket">Comprar Ticket</NavLink>
        <NavLink class="nav-link" href="estudiante/notificaciones">Notificaciones</NavLink>
    }
    else if (Sesion.Usuario?.EsConductor == true)
    {
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        <NavLink class="nav-link" href="conductor/mis-viajes">Mis Viajes</NavLink>
        <NavLink class="nav-link" href="conductor/validar-acceso">Validar Abordaje</NavLink>
        <NavLink class="nav-link" href="notificaciones">Notificaciones</NavLink>
    }
    else if (Sesion.Usuario?.EsAdministradorTransporte == true)
    {
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">Inicio</NavLink>
        <NavLink class="nav-link" href="admin/autobuses">Autobuses</NavLink>
        <NavLink class="nav-link" href="admin/incidencias">Incidencias</NavLink>
        <NavLink class="nav-link" href="notificaciones">Notificaciones</NavLink>
    }

</nav>
