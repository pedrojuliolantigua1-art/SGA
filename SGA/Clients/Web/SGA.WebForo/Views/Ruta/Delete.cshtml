@model SGA.Application.DTOs.Rutas.RutaDto
@{
    ViewData["Title"] = "Eliminar ruta";
}

<h2>Eliminar ruta</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="alert alert-warning">
    ¿Confirma que desea eliminar la ruta <strong>@Model.Nombre</strong>? Las paradas, horarios y viajes
    asociados no se eliminan.
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label class="form-label">Motivo</label>
        <input name="Motivo" class="form-control" />
    </div>
    <input type="hidden" name="EliminadoPor" value="@User.Identity?.Name" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
