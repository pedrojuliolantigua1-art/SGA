@model SGA.Application.DTOs.Rutas.ActualizarRutaDto
@{
    ViewData["Title"] = "Editar Ruta";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Editar Ruta</h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-medium"></label>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label fw-medium"></label>
                    <textarea asp-for="Descripcion" class="form-control"></textarea>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Activa" class="form-check-input" />
                    <label asp-for="Activa" class="form-check-label"></label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary flex-fill py-2 fw-semibold">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
