@model List<SGA.Application.DTOs.Rutas.RutaDto>

@{
    ViewData["Title"] = "Rutas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Rutas</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Nueva ruta
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Index" method="get" class="d-flex mb-4" style="max-width: 400px;">
    <input type="text" name="nombre" value="@ViewBag.Nombre" class="form-control me-2" placeholder="Buscar por nombre..." />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Nombre))
    {
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Limpiar</a>
    }
</form>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Activa</th>
            <th width="120">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var ruta in Model)
            {
                <tr>
                    <td>@ruta.Nombre</td>
                    <td>@ruta.Descripcion</td>
                    <td>
                        @if (ruta.Activa)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@ruta.Id" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@ruta.Id" class="btn btn-warning btn-sm">Editar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">
                    No hay rutas registradas.
                </td>
            </tr>
        }
    </tbody>
</table>
