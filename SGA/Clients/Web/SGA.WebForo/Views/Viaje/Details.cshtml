@using SGA.Domain.Enum
@model SGA.Application.DTOs.Viajes.ViajeDto

@{
    ViewData["Title"] = "Detalle del viaje";
    var badge = Model.Estado switch
    {
        EstadoViaje.Programado => "primary",
        EstadoViaje.EnCurso => "warning",
        EstadoViaje.Finalizado => "success",
        EstadoViaje.Cancelado => "danger",
        EstadoViaje.Retrasado => "secondary",
        _ => "secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Detalle del viaje #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ruta</dt>
            <dd class="col-sm-9">#@Model.RutaId</dd>

            <dt class="col-sm-3">Horario</dt>
            <dd class="col-sm-9">#@Model.HorarioRutaId</dd>

            <dt class="col-sm-3">Autobús</dt>
            <dd class="col-sm-9">#@Model.AutobusId</dd>

            <dt class="col-sm-3">Conductor</dt>
            <dd class="col-sm-9">#@Model.ConductorId</dd>

            <dt class="col-sm-3">Fecha</dt>
            <dd class="col-sm-9">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Hora inicio real</dt>
            <dd class="col-sm-9">@(Model.HoraInicioReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

            <dt class="col-sm-3">Hora fin real</dt>
            <dd class="col-sm-9">@(Model.HoraFinReal?.ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

            <dt class="col-sm-3">Cupo</dt>
            <dd class="col-sm-9">@Model.CupoActual / @Model.CapacidadMaxima</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="badge bg-@badge">@Model.Estado</span></dd>
        </dl>
    </div>
</div>

<div class="row g-3">
    @if (Model.Estado == EstadoViaje.Programado)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <h5>Iniciar viaje</h5>
                <form asp-action="Iniciar" method="post">
                    <input type="hidden" name="viajeId" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label">Conductor</label>
                        <input name="conductorId" type="number" class="form-control" value="@Model.ConductorId" required />
                    </div>
                    <button type="submit" class="btn btn-warning w-100">Confirmar inicio</button>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h5>Cancelar viaje</h5>
                <form asp-action="Cancelar" method="post">
                    <input type="hidden" name="viajeId" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label">Motivo</label>
                        <input name="motivo" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-outline-danger w-100">Cancelar viaje</button>
                </form>
            </div>
        </div>
    }

    @if (Model.Estado == EstadoViaje.EnCurso)
    {
        <div class="col-md-4">
            <div class="card p-3">
                <h5>Finalizar viaje</h5>
                <form asp-action="Finalizar" method="post">
                    <input type="hidden" name="viajeId" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label">Conductor</label>
                        <input name="conductorId" type="number" class="form-control" value="@Model.ConductorId" required />
                    </div>
                    <button type="submit" class="btn btn-success w-100">Confirmar finalización</button>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card p-3">
                <h5>Reportar incidencia</h5>
                <form asp-action="ReportarIncidencia" method="post">
                    <input type="hidden" name="viajeId" value="@Model.Id" />
                    <div class="mb-2">
                        <label class="form-label">Conductor</label>
                        <input name="conductorId" type="number" class="form-control" value="@Model.ConductorId" required />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Tipo</label>
                        <select name="tipo" class="form-select">
                            <option>Retraso</option>
                            <option>Avería</option>
                            <option>Desvío</option>
                            <option>Otro</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Descripción</label>
                        <textarea name="descripcion" class="form-control" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-outline-warning w-100">Reportar</button>
                </form>
            </div>
        </div>
    }
</div>
