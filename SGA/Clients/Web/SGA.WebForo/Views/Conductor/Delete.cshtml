@model SGA.Application.DTOs.Usuarios.ConductorDto
@{
    ViewData["Title"] = "Eliminar conductor";
}

<h2>Eliminar conductor</h2>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="alert alert-warning">
    ¿Confirma que desea eliminar al conductor <strong>@Model.Nombre @Model.Apellido</strong>?
    El historial asociado no se elimina.
</div>

<dl class="row">
    <dt class="col-sm-3">Correo</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
    <dt class="col-sm-3">Licencia</dt>
    <dd class="col-sm-9">@Model.NumeroLicencia</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <div class="mb-3">
        <label class="form-label">Motivo</label>
        <input name="Motivo" class="form-control" />
    </div>
    <input type="hidden" name="EliminadoPor" value="@User.Identity?.Name" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
