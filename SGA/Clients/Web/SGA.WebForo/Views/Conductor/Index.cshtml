@model List<SGA.Application.DTOs.Usuarios.ConductorDto>

@{
    ViewData["Title"] = "Conductores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Conductores</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Nuevo conductor
    </a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form asp-action="Index" method="get" class="d-flex mb-4" style="max-width: 400px;">
    <input type="text" name="nombre" value="@ViewBag.Nombre" class="form-control me-2" placeholder="Buscar por nombre..." />
    <button type="submit" class="btn btn-outline-primary">Buscar</button>
    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Nombre))
    {
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Limpiar</a>
    }
</form>

<div class="bg-dark text-white rounded p-3 mb-4">
    <div class="row text-center">
        <div class="col">
            <h4>@Model.Count</h4>
            <small>Total</small>
        </div>
        <div class="col">
            <h4>@Model.Count(c => c.Disponible)</h4>
            <small>Disponibles</small>
        </div>
        <div class="col">
            <h4>@Model.Count(c => !c.Disponible)</h4>
            <small>No disponibles</small>
        </div>
    </div>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Licencia</th>
            <th>Vence</th>
            <th>Disponible</th>
            <th width="140">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var conductor in Model)
            {
                <tr>
                    <td>@conductor.Nombre @conductor.Apellido</td>
                    <td>@conductor.Correo</td>
                    <td>@conductor.NumeroLicencia</td>
                    <td>@(conductor.FechaVencimientoLicencia?.ToString("dd/MM/yyyy") ?? "-")</td>
                    <td>
                        @if (conductor.Disponible)
                        {
                            <span class="badge bg-success">Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@conductor.Id" class="btn btn-info btn-sm">Detalles</a>
                        <a asp-action="Edit" asp-route-id="@conductor.Id" class="btn btn-warning btn-sm">Editar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">
                    No hay conductores registrados.
                </td>
            </tr>
        }
    </tbody>
</table>
