@model SGA.Application.DTOs.Usuarios.ActualizarConductorDto
@{
    ViewData["Title"] = "Editar Conductor";
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Editar Conductor</h2>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@ViewBag.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label fw-medium"></label>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Apellido" class="form-label fw-medium"></label>
                    <input asp-for="Apellido" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Correo" class="form-label fw-medium"></label>
                    <input asp-for="Correo" type="email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label fw-medium"></label>
                    <input asp-for="Telefono" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="NumeroLicencia" class="form-label fw-medium">Número de licencia</label>
                    <input asp-for="NumeroLicencia" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="FechaVencimientoLicencia" class="form-label fw-medium">Vencimiento de licencia</label>
                    <input asp-for="FechaVencimientoLicencia" type="date" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill py-2 fw-semibold">Guardar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary flex-fill py-2 fw-semibold">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
