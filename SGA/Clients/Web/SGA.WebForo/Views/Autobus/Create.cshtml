@model SGA.Application.DTOs.Autobuses.CrearAutobusDto
@{
    ViewData["Title"] = "Registrar autobus";
}

<h2>Registrar autobus</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Placa" class="form-label"></label>
        <input asp-for="Placa" class="form-control" />
        <span asp-validation-for="Placa" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Marca" class="form-label"></label>
        <input asp-for="Marca" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Modelo" class="form-label"></label>
        <input asp-for="Modelo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Capacidad" class="form-label"></label>
        <input asp-for="Capacidad" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Foto (opcional)</label>
        <input type="file" name="foto" class="form-control" accept="image/*" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>