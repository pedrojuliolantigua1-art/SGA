@model List<SGA.Application.DTOs.Auditoria.AuditoriaDto>

@{
    ViewData["Title"] = "Auditoria";
    var desde = (DateTime)ViewBag.Desde;
    var hasta = (DateTime)ViewBag.Hasta;
}

<style>
    .sga-section-title {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6c757d;
        font-weight: 600;
    }
</style>

<div class="mb-4">
    <div class="sga-section-title mb-1">Control y trazabilidad</div>
    <h2 class="fw-bold mb-0">Registro de auditoria</h2>
    <p class="text-muted mb-0">Registro de solo lectura. Ninguna accion aqui puede modificarse ni eliminarse.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-3">
        <form asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Desde</label>
                <input type="date" name="desde" value="@desde.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Hasta</label>
                <input type="date" name="hasta" value="@hasta.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Id del actor</label>
                <input type="number" name="actorId" value="@ViewBag.ActorId" class="form-control" style="width: 120px;" />
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Accion</label>
                <input type="text" name="accion" value="@ViewBag.Accion" class="form-control" placeholder="Ej. CrearAsync" />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            </div>
            <div class="col-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Fecha y hora</th>
                    <th>Actor</th>
                    <th>Accion</th>
                    <th>Entidad afectada</th>
                    <th class="text-end" style="width: 100px;">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var registro in Model)
                    {
                        <tr>
                            <td>@registro.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>#@registro.UsuarioTransporteId</td>
                            <td><span class="badge text-bg-light border">@registro.Accion</span></td>
                            <td>@registro.EntidadAfectada @(!string.IsNullOrEmpty(registro.EntidadId) ? $"#{registro.EntidadId}" : "")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@registro.Id" class="btn btn-sm btn-outline-info">Ver</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">No hay registros para los filtros indicados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
