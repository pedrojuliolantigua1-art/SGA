@model SGA.Application.DTOs.Horarios.HorarioRutaDto
@{
    ViewData["Title"] = "Detalle del horario";
}

<style>
    .sga-section-title {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #6c757d;
        font-weight: 600;
    }
</style>

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <div class="sga-section-title mb-1">Programación / Horario</div>
        <h2 class="fw-bold mb-0">@Model.HoraSalida.ToString(@"hh\:mm") &rarr; @Model.HoraLlegadaEstimada.ToString(@"hh\:mm")</h2>
    </div>
    <a asp-action="Index" asp-route-rutaId="@Model.RutaId" class="btn btn-outline-secondary">&larr; Volver</a>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<div class="card shadow-sm border-0 rounded-4" style="max-width: 560px;">
    <div class="card-body p-4">
        <dl class="row mb-0">
            <dt class="col-sm-4 sga-section-title">Ruta</dt>
            <dd class="col-sm-8">#@Model.RutaId</dd>

            <dt class="col-sm-4 sga-section-title">Salida</dt>
            <dd class="col-sm-8">@Model.HoraSalida.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-4 sga-section-title">Llegada estimada</dt>
            <dd class="col-sm-8">@Model.HoraLlegadaEstimada.ToString(@"hh\:mm")</dd>

            <dt class="col-sm-4 sga-section-title">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activo)
                {
                    <span class="badge rounded-pill text-bg-success">Activo</span>
                }
                else
                {
                    <span class="badge rounded-pill text-bg-secondary">Inactivo</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer bg-transparent border-0 p-4 pt-0">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    </div>
</div>